#!/usr/bin/env bash
# codex-pro-call — integrity-check and execute the bundled codex-call snapshot.

set -uo pipefail

EXPECTED_SHA256="50ab7eb4296ca1b1cccf3b0707a0bd5f6ffe0acce14a9ef4bd31a0caf1a9098d"

if ! SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)"; then
  printf 'error=runtime_missing path=unresolved\n' >&2
  exit 2
fi
RUNTIME_PATH="$SCRIPT_DIR/codex-call"

platform="$(uname -s 2>/dev/null || printf unknown)"
if [ "$platform" != "Darwin" ]; then
  printf 'error=unsupported_platform actual=%s expected=Darwin\n' "$platform" >&2
  exit 2
fi

SWIFT_PATH="/usr/bin/swift"
if [ ! -f "$SWIFT_PATH" ] || [ ! -x "$SWIFT_PATH" ]; then
  printf 'error=swift_missing\n' >&2
  exit 2
fi
if ! swift_version="$("$SWIFT_PATH" --version 2>/dev/null)" || [ -z "$swift_version" ]; then
  printf 'error=swift_missing\n' >&2
  exit 2
fi
swift_version="${swift_version%%$'\n'*}"

if [ -L "$RUNTIME_PATH" ] || [ ! -e "$RUNTIME_PATH" ] || [ ! -f "$RUNTIME_PATH" ]; then
  printf 'error=runtime_missing path=%s\n' "$RUNTIME_PATH" >&2
  exit 2
fi
if [ ! -x "$RUNTIME_PATH" ]; then
  printf 'error=runtime_not_executable path=%s\n' "$RUNTIME_PATH" >&2
  exit 2
fi

if ! hash_output="$(shasum -a 256 "$RUNTIME_PATH" 2>/dev/null)"; then
  printf 'error=hash_mismatch expected=%s actual=unavailable\n' "$EXPECTED_SHA256" >&2
  exit 2
fi
actual_sha256="${hash_output%%[[:space:]]*}"
if [ "$actual_sha256" != "$EXPECTED_SHA256" ]; then
  printf 'error=hash_mismatch expected=%s actual=%s\n' "$EXPECTED_SHA256" "$actual_sha256" >&2
  exit 2
fi

if [ "${1:-}" = "--check" ]; then
  printf 'ok runtime=%s sha256=%s swift=%s\n' "$RUNTIME_PATH" "$EXPECTED_SHA256" "$swift_version"
  exit 0
fi

exec "$RUNTIME_PATH" "$@"
